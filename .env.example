APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:1515

# Local dev: false = recompile Blade every request; production: true or omit
VIEW_CACHE_COMPILED=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Docker Compose (default): host Artisan uses MySQL on published port; php-fpm overrides host via compose env
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=1517
DB_DATABASE=blog
DB_USERNAME=user
DB_PASSWORD=password

# SQLite-only (no Docker): set DB_CONNECTION=sqlite and DB_DATABASE=database/database.sqlite

# file/sync avoid extra DB tables for sessions/cache/queue; use database drivers if you need them
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# sync = no broker; rabbitmq = Docker service `rabbitmq` + `queue-worker`
QUEUE_CONNECTION=rabbitmq

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
# Docker Compose service name is redis; on host without Redis in compose use 127.0.0.1
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# RabbitMQ: веб-интерфейс http://localhost:1522 (не 1523 — там только AMQP для приложений)
# Docker: host rabbitmq, порт 5672; с хоста для AMQP: 127.0.0.1 и порт из compose (1523:5672)
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=blog
RABBITMQ_PASSWORD=blog
RABBITMQ_VHOST=/
RABBITMQ_QUEUE=default

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
