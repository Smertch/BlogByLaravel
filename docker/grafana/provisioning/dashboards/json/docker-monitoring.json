{
  "annotations": { "list": [] },
  "description": "Мониторинг Docker через Prometheus + cAdvisor. Запросы не зависят от label image/name (у части сборок cAdvisor их нет — тогда в легенде короткий id контейнера). Импортированный с grafana.com дашборд 193 с фильтром image!=\"\" в такой среде пустой — используйте этот файл.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "panels": [],
      "title": "Обзор",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-blog" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus-blog" },
          "editorMode": "code",
          "expr": "count(count by (id) (container_last_seen{job=\"cadvisor\", id=~\"/docker/.+\", id!=\"/docker\"}))",
          "legendFormat": "__auto",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Контейнеры (Docker cgroup)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-blog" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "purple", "value": null }] },
          "unit": "decmbytes"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus-blog" },
          "editorMode": "code",
          "expr": "sum(container_memory_usage_bytes{job=\"cadvisor\", id=~\"/docker/.+\", id!=\"/docker\"}) / 1024 / 1024",
          "legendFormat": "RSS+cache (usage)",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Сумма памяти контейнеров (MiB)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-blog" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus-blog" },
          "editorMode": "code",
          "expr": "sum(rate(container_cpu_usage_seconds_total{job=\"cadvisor\", id=~\"/docker/.+\", id!=\"/docker\"}[5m])) * 100",
          "legendFormat": "Σ ядер × %",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Суммарная загрузка CPU (%)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-blog" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 1,
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "semi-dark-orange", "value": null }] },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "id": 4,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus-blog" },
          "editorMode": "code",
          "expr": "container_cpu_load_average_10s{job=\"cadvisor\", id=\"/\"}",
          "legendFormat": "load 10s",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Load average (root cgroup, если есть)",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 101,
      "panels": [],
      "title": "CPU по контейнерам",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-blog" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 25,
            "gradientMode": "opacity",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "insertNulls": false,
            "lineInterpolation": "smooth",
            "lineWidth": 1,
            "pointSize": 5,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "normal" },
            "thresholdsStyle": { "mode": "off" }
          },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 6 },
      "id": 10,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "right", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus-blog" },
          "editorMode": "code",
          "expr": "sum by (cid) (label_replace(rate(container_cpu_usage_seconds_total{job=\"cadvisor\", id=~\"/docker/.+\", id!=\"/docker\"}[5m]), \"cid\", \"$1\", \"id\", \".*/docker/(.{16}).*\")) * 100",
          "legendFormat": "docker/{{cid}}…",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "CPU % по контейнеру (по id cgroup; при появлении name в метриках можно добавить второй ряд)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 16 },
      "id": 102,
      "panels": [],
      "title": "Память по контейнерам",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-blog" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 20,
            "gradientMode": "opacity",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "insertNulls": false,
            "lineInterpolation": "smooth",
            "lineWidth": 1,
            "pointSize": 5,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "normal" },
            "thresholdsStyle": { "mode": "off" }
          },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] },
          "unit": "bytes"
        },
        "overrides": []
      },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 17 },
      "id": 20,
      "options": {
        "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "right", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus-blog" },
          "editorMode": "code",
          "expr": "sum by (cid) (label_replace(container_memory_usage_bytes{job=\"cadvisor\", id=~\"/docker/.+\", id!=\"/docker\"}, \"cid\", \"$1\", \"id\", \".*/docker/(.{16}).*\"))",
          "legendFormat": "docker/{{cid}}…",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Память (usage) по контейнеру",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 27 },
      "id": 103,
      "panels": [],
      "title": "Сеть (часто только агрегат на id=\"/\")",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-blog" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 10,
            "gradientMode": "none",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "insertNulls": false,
            "lineInterpolation": "smooth",
            "lineWidth": 1,
            "pointSize": 5,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "off" }
          },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] },
          "unit": "Bps"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 28 },
      "id": 30,
      "options": {
        "legend": { "calcs": ["mean"], "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus-blog" },
          "editorMode": "code",
          "expr": "sum by (interface) (rate(container_network_receive_bytes_total{job=\"cadvisor\", id=\"/\"}[5m]))",
          "legendFormat": "RX {{interface}}",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus-blog" },
          "editorMode": "code",
          "expr": "sum by (interface) (rate(container_network_transmit_bytes_total{job=\"cadvisor\", id=\"/\"}[5m]))",
          "legendFormat": "TX {{interface}}",
          "range": true,
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus-blog" },
          "editorMode": "code",
          "expr": "sum by (name) (rate(container_network_receive_bytes_total{job=\"cadvisor\", name!=\"\"}[5m]))",
          "legendFormat": "RX {{name}}",
          "range": true,
          "refId": "C"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus-blog" },
          "editorMode": "code",
          "expr": "sum by (name) (rate(container_network_transmit_bytes_total{job=\"cadvisor\", name!=\"\"}[5m]))",
          "legendFormat": "TX {{name}}",
          "range": true,
          "refId": "D"
        }
      ],
      "title": "Сеть: root + по name (если cAdvisor отдаёт name)",
      "type": "timeseries"
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["docker", "cadvisor", "prometheus", "blog"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Docker monitoring",
  "uid": "docker-monitoring",
  "version": 1
}
